# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Course data (local only; not committed to the public repository).
# Only the README placeholders under data/ are committed; all data files stay
# local. *.csv is a safety net (covers data/raw/public.csv and generated CSVs).
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md
*.csv

# Generated result tables are aggregate outputs (not raw course data); commit them.
!outputs/tables/*.csv

# Secrets / environment variables
.env
*.env
